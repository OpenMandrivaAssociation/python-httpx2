--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,26 +1,19 @@
 [build-system]
-requires = ["hatchling", "hatch-fancy-pypi-readme", "uv-dynamic-versioning>=0.14.1"]
+requires = ["hatchling"]
 build-backend = "hatchling.build"
 
-[tool.hatch.version]
-source = "uv-dynamic-versioning"
-
-[tool.uv-dynamic-versioning]
-vcs = "git"
-style = "pep440"
-bump = true
-fallback-version = "0.0.0"
-
 [project]
 name = "httpx2"
+version = "2.13.1"
 description = "The next generation HTTP client."
+readme = "README.md"
 license = "BSD-3-Clause"
 requires-python = ">=3.10"
 authors = [
     { name = "Tom Christie", email = "tom@tomchristie.com" },
 ]
 maintainers = [
-    { name = "Pydantic Services Inc.", email = "engineering@pydantic.dev" }
+    { name = "Pydantic Services Inc.", email = "engineering@pydantic.dev" },
 ]
 classifiers = [
     "Development Status :: 5 - Production/Stable",
@@ -41,16 +34,13 @@
     "Programming Language :: Python :: 3.15",
     "Topic :: Internet :: WWW/HTTP",
 ]
-dynamic = ["readme", "version", "dependencies"]
-
-[tool.hatch.metadata.hooks.uv-dynamic-versioning]
 dependencies = [
-    "truststore>=0.10; sys_platform != 'emscripten'",
-    "httpcore2=={{ version }}; sys_platform != 'emscripten'",
     "anyio>=4.10; sys_platform != 'emscripten'",
+    "httpcore2==2.13.1; sys_platform != 'emscripten'",
     "httpx2-jsfetch; sys_platform == 'emscripten' and python_version >= '3.12'",
     "idna>=3.18",
-    "typing_extensions>=4.5.0; python_version < '3.13'",
+    "truststore>=0.10; sys_platform != 'emscripten'",
+    "typing-extensions>=4.5.0; python_version < '3.13'",
 ]
 
 [project.optional-dependencies]
@@ -72,7 +62,6 @@
 ws = [
     "wsproto>=1.2",
 ]
-# TODO(Marcelo): Remove when Python 3.13 reaches EOL.
 zstd = [
     "backports.zstd>=1.0.0; python_version <= '3.13'",
 ]
@@ -85,32 +74,5 @@
 Homepage = "https://github.com/pydantic/httpx2"
 Source = "https://github.com/pydantic/httpx2"
 
-[tool.hatch.build.targets.sdist]
-include = ["/httpx2", "/CHANGELOG.md"]
-
-[tool.hatch.build.targets.sdist.force-include]
-"../../README.md" = "README.md"
-"../../LICENSE.md" = "LICENSE.md"
-
 [tool.hatch.build.targets.wheel]
 packages = ["httpx2"]
-
-[tool.hatch.metadata.hooks.fancy-pypi-readme]
-content-type = "text/markdown"
-
-[[tool.hatch.metadata.hooks.fancy-pypi-readme.fragments]]
-path = "../../README.md"
-
-[[tool.hatch.metadata.hooks.fancy-pypi-readme.fragments]]
-text = "\n## Release Information\n\n"
-
-[[tool.hatch.metadata.hooks.fancy-pypi-readme.fragments]]
-path = "CHANGELOG.md"
-pattern = "\n(## [0-9].+?)(?=\n## |$)"
-
-[[tool.hatch.metadata.hooks.fancy-pypi-readme.fragments]]
-text = "\n---\n\n[Full changelog](https://github.com/pydantic/httpx2/blob/main/src/httpx2/CHANGELOG.md)\n"
-
-[[tool.hatch.metadata.hooks.fancy-pypi-readme.substitutions]]
-pattern = 'src="(docs/img/.*?)"'
-replacement = 'src="https://raw.githubusercontent.com/pydantic/httpx2/main/\1"'
